---
import { sitePath } from "../utils/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionNav from "../components/SectionNav.astro";
import Arrow from "../components/Arrow.astro";
import TeamFinder from "../components/TeamFinder.astro";
import FAQ from "../components/FAQ.astro";
import ConnectLinks from "../components/ConnectLinks.astro";
import Icon from "../components/Icon.astro";
import { contactEmail, contactHref, emailSignupUrl } from "../data/connect";
---

<BaseLayout
  title="Get Involved"
  description="Student participation and partnership opportunities with Cyber Flyers at the University of Dayton."
>
  <PageHeader
    eyebrow="STUDENTS & PARTNERS"
    title="Get involved."
    description="Join our mailing list, explore a place on the team, or start a conversation about working together."
  />
  <SectionNav section="involvement" />
  <section class="section">
    <div class="container involvement-grid">
      <article>
        <h2 id="students">Interested in Cyber Flyers?</h2>
        <p>
          Cyber Flyers includes students from technical and nontechnical majors.
          The teams work on communication, events, phishing simulations,
          training, and research.
        </p>
        <p>
          Leave your email to join our mailing list and let us know if you'd
          like to join Cyber Flyers in the future.
        </p>
        <a
          class="button button-primary"
          href={emailSignupUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-describedby="signup-note"
        >
          Join the mailing list
          <Icon name="mail" size={20} />
        </a>
        <p class="signup-note" id="signup-note">
          Joining the mailing list does not make you a member.
        </p>
        <a class="text-link" href={contactHref}>
          Questions? Email our team
        </a>
      </article>
      <article>
        <h2>Team responsibilities.</h2>
        <ul class="line-list">
          <li>
            <span>
              <a href={sitePath("/teams/#cmac")}>CMAC</a>: social media,
              educational campaigns, campus outreach, and events.
            </span>
          </li>
          <li>
            <span>
              <a href={sitePath("/teams/#psat")}>PSAT</a>: phishing simulations,
              training, and cybermindfulness research.
            </span>
          </li>
          <li>
            <span>
              <a href={sitePath("/teams/#ctmr")}>CTMR</a>: threat research,
              educational articles, and training material.
            </span>
          </li>
        </ul>
      </article>
    </div>
  </section>
  <section class="section finder-section" id="find-your-place">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">EXPLORE YOUR INTERESTS</span>
          <h2>
            Find your place
            <br />
            <em>in cyber.</em>
          </h2>
        </div>
      </div>
      <TeamFinder />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">WORK WITH US</span>
          <h2 id="partners">Partnerships.</h2>
        </div>
      </div>
      <div class="partnership-intro">
        <p>
          Have an idea for an event, project, or collaboration? Tell us what you
          have in mind and connect with the Cyber Flyers team.
        </p>
        <a class="text-link contact-link" href={contactHref}>
          <Icon name="mail" size={20} />
          {contactEmail}
        </a>
      </div>
      <div class="partnership-grid">
        <article data-reveal>
          <h3>Campus organizations and departments</h3>
          <p>
            Potential collaborations include educational campaigns, campus
            events, guest speakers, and training or research projects.
          </p>
        </article>
        <article data-reveal>
          <h3>Community and industry partners</h3>
          <p>
            Partners can contribute professional experience through guest
            speaking, event collaboration, and research partnerships.
          </p>
        </article>
        <article data-reveal>
          <h3>Mentoring and professional opportunities</h3>
          <p>
            Potential collaborations include mentoring, site visits, shadowing,
            and sharing internships or project opportunities through the
            appropriate University process.
          </p>
        </article>
        <article data-reveal>
          <h3>Event and program support</h3>
          <p>
            Future sponsorship or program-support opportunities may be added
            following University and Cyber Flyers leadership approval.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="connect">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">KEEP IN TOUCH</span>
          <h2 id="connect">Connect with Cyber Flyers.</h2>
        </div>
      </div>
      <ConnectLinks />
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <div class="section-heading">
        <div>
          <span class="eyebrow">COMMON QUESTIONS</span>
          <h2>Before you join.</h2>
        </div>
      </div>
      <FAQ />
      <a class="text-link content-next" href={sitePath("/faq/")}>
        All frequently asked questions
        <Arrow />
      </a>
    </div>
  </section>
</BaseLayout>
