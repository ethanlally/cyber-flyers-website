---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout
  title="Get Involved"
  description="Student participation and partnership opportunities with Cyber Flyers at the University of Dayton."
>
  <PageHeader
    title="Get involved"
    description="Information for students interested in Cyber Flyers and organizations interested in collaborating."
  />
  <section class="section container split">
    <div>
      <h2>Student participation</h2>
      <p>
        Cyber Flyers includes students from technical and nontechnical majors.
        The teams work on communication, events, phishing simulations, training,
        and research.
      </p>
      <p class="status-note">Student joining information coming soon.</p>
    </div>
    <div>
      <h3>Team responsibilities</h3>
      <ul>
        <li>
          <a href="/teams/#cmac">CMAC</a>: social media, educational campaigns,
          campus outreach, and events.
        </li>
        <li>
          <a href="/teams/#psat">PSAT</a>: phishing simulations, training, and
          cybermindfulness research.
        </li>
        <li>
          <a href="/teams/#ctmr">CTMR</a>: threat research, educational
          articles, and training material.
        </li>
      </ul>
    </div>
  </section>
  <section class="section container">
    <h2>Partnerships</h2>
    <div class="partner-grid">
      <article>
        <h3>Campus organizations and departments</h3>
        <p>
          Potential collaborations include educational campaigns, campus events,
          guest speakers, and training or research projects.
        </p>
        <p class="status-note">
          Campus partnership contact information coming soon.
        </p>
      </article>
      <article>
        <h3>Community and industry partners</h3>
        <p>
          Partners can contribute professional experience through guest
          speaking, event collaboration, and research partnerships.
        </p>
        <p class="status-note">Partner contact information coming soon.</p>
      </article>
    </div>
  </section>
</BaseLayout>
