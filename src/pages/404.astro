---
import { sitePath } from "../utils/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Arrow from "../components/Arrow.astro";
---

<BaseLayout
  title="Page Not Found"
  description="This page could not be found. Return to Cyber Flyers to explore our teams, programs, and resources."
>
  <PageHeader
    eyebrow="404"
    title="Page not found"
    description="The page you're looking for may have moved, or the address may be incorrect."
  />
  <div class="container section">
    <a class="button button-red" href={sitePath("/")}>
      Back to Cyber Flyers <Arrow diagonal />
    </a>
  </div>
</BaseLayout>
