---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionNav from "../components/SectionNav.astro";
import FAQ from "../components/FAQ.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import { allFAQs } from "../data/opportunities";
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about Cyber Flyers participation, teams, and partnerships."
>
  <PageHeader
    eyebrow="GET INVOLVED / FAQ"
    title="Questions are a"
    accent="good place to start."
    description="Learn about participation, team interests, and ways to collaborate with Cyber Flyers."
  />
  <SectionNav section="involvement" />
  <section class="section">
    <div class="container narrow">
      <div class="section-heading">
        <div>
          <span class="eyebrow">BEFORE YOU JOIN</span>
          <h2>Common questions.</h2>
        </div>
      </div>
      <FAQ items={allFAQs} />
    </div>
  </section>
  <ClosingCTA
    title="Start with your interests."
    text="Explore communication, training, and research with our team finder."
    href="/get-involved/#find-your-place"
    label="Find your place"
  />
</BaseLayout>
