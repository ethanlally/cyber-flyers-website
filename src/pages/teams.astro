---
import { sitePath } from "../utils/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Arrow from "../components/Arrow.astro";
import {
  academicYear,
  teams,
  programs,
  memberById,
  executiveDirector,
} from "../data/content";
const executive = memberById(executiveDirector);
---

<BaseLayout
  title="Our Teams"
  description="Meet the 2026–2027 Cyber Flyers leadership and the students behind CMAC, PSAT, and CTMR."
>
  <PageHeader
    eyebrow={`Academic year ${academicYear}`}
    title="Our teams."
    description="Team responsibilities and the current student roster. Some members contribute to more than one team."
  />
  <nav class="container subnav" aria-label="Jump to team">
    {teams.map((team, i) => (
      <a href={`#${team.id}`}>
        0{i + 1} / {team.acronym}
        <Arrow diagonal />
      </a>
    ))}
  </nav>
  <div class="container executive-bar">
    <span class="eyebrow">Executive Director</span>
    <strong>{executive.name}</strong>
    <span>
      {executive.standing} · {executive.majors}
    </span>
    <a class="text-link" href={sitePath("/about/#leadership")}>
      About our leadership <Arrow />
    </a>
  </div>
  {teams.map((team, i) => {
    const director = memberById(team.director);
    const roster = [director, ...team.memberIds.map(memberById)];
    return (
      <section
        class:list={["section", "team-detail", team.id]}
        aria-labelledby={`${team.id}-title`}
      >
        <div class="container">
          <div class="team-detail-heading" id={team.id} data-reveal>
            <span class="giant-code" aria-hidden="true">
              {team.acronym}
            </span>
            <div>
              <span class="eyebrow">
                0{i + 1} / {team.acronym}
              </span>
              <h2 id={`${team.id}-title`}>{team.name}</h2>
              <p class="lead">{team.mission}</p>
            </div>
          </div>
          <div class="team-detail-body">
            <div>
              <h3 class="eyebrow">This year’s priorities</h3>
              <ul class="line-list">
                {team.priorities.map((priority) => (
                  <li>{priority}</li>
                ))}
              </ul>
              <div class="team-outcome">
                <h3 class="eyebrow">Related programs</h3>
                <div class="stack-links">
                  {team.programIds.map((id) => (
                    <a class="text-link" href={sitePath(`/programs/#${id}`)}>
                      {programs.find((p) => p.id === id)!.name}
                      <Arrow diagonal />
                    </a>
                  ))}
                </div>
              </div>
            </div>
            <div class="roster">
              <div class="roster-heading">
                <h3 class="eyebrow">Members / AY {academicYear}</h3>
                <span>{roster.length} students</span>
              </div>
              {roster.map((person) => (
                <div class="roster-person">
                  <div>
                    <strong>{person.name}</strong>
                    {person.id === team.director && (
                      <span class="director-label">Director</span>
                    )}
                  </div>
                  <span>
                    {person.standing} · {person.majors}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
