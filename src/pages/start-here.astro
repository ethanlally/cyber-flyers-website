---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionNav from "../components/SectionNav.astro";
import Arrow from "../components/Arrow.astro";
import { learningSteps } from "../data/opportunities";
import { sitePath } from "../utils/paths";
---

<BaseLayout
  title="Start Here in Cybersecurity"
  description="A beginner-friendly pathway through cybersecurity concepts, common threats, defensive habits, and Cyber Flyers involvement."
>
  <PageHeader
    eyebrow="RESOURCES / GETTING STARTED"
    title="Cybersecurity starts"
    accent="with good habits."
    description="A beginner-friendly pathway into foundational concepts, common threats, defensive practices, and Cyber Flyers involvement."
  />
  <SectionNav section="resources" />
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">A FIVE-STEP PATHWAY</span>
          <h2>Start where you are.</h2>
        </div>
      </div>
      <ol class="content-grid content-grid-two learning-path">
        {learningSteps.map((step, i) => (
          <li class="content-card" data-reveal>
            <span class="eyebrow">STEP {String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <a class="text-link" href={sitePath(step.href)}>
              {step.label}
              <Arrow diagonal />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section pale-section">
    <div class="container editorial-split">
      <div>
        <span class="eyebrow">05 / GET INVOLVED</span>
        <h2>Learn by doing with Cyber Flyers.</h2>
      </div>
      <div class="prose">
        <p>
          Explore the three teams and identify a participation path that matches
          your interests. You do not need to understand every part of
          cybersecurity before you begin.
        </p>
        <div class="stack-links">
          <a
            class="text-link"
            href={sitePath("/get-involved/#find-your-place")}
          >
            Find your place
            <Arrow diagonal />
          </a>
          <a class="text-link" href={sitePath("/faq/")}>
            Read the FAQ
            <Arrow diagonal />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
