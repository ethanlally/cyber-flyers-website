---
import { sitePath } from "../utils/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Arrow from "../components/Arrow.astro";
import { academicYear, members, teams } from "../data/content";
const highlights = [
  {
    title: "Campus tabling",
    description:
      "Tabling at Up the Orgs and in Kennedy Union created opportunities to talk with students about cybersecurity and introduce the team’s work.",
  },
  {
    title: "Guest speakers",
    description:
      "Guest speakers brought perspectives from industry to campus, connecting student questions with professional experience.",
  },
  {
    title: "Training and simulations",
    description:
      "The team developed cybersecurity training modules for UDit and ran phishing simulations as part of its education work.",
  },
  {
    title: "Articles and podcast",
    description:
      "Cyber Flyers published blog articles and partnered with the Hanley Sustainability Institute on a podcast exploring the implications of AI.",
  },
];
---

<BaseLayout
  title="Impact & Reports"
  description="Cyber Flyers activities from 2025–2026 and information about the current 2026–2027 team."
>
  <PageHeader
    eyebrow="OUR PROGRESS"
    title="Impact &"
    accent="reports."
    description="Past activities and annual reports, organized by academic year."
  />
  <section class="section">
    <div class="container editorial-split" data-reveal>
      <div>
        <span class="eyebrow">OUR CURRENT CHAPTER</span>
        <h2>{academicYear}</h2>
      </div>
      <div class="prose">
        <p class="lead">
          The current roster includes {members.length} students across{" "}
          {teams.length} teams.
        </p>
        <p>Activities and results will be added as the year progresses.</p>
        <div class="stack-links">
          <a class="text-link" href={sitePath("/teams/")}>
            Current team <Arrow diagonal />
          </a>
          <a class="text-link" href={sitePath("/programs/")}>
            Programs and research priorities <Arrow diagonal />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section pale-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FROM THE ANNUAL REPORT</span>
          <h2 id="highlights">2025–2026 highlights.</h2>
        </div>
      </div>
      <div class="partnership-grid">
        {highlights.map((highlight) => (
          <article data-reveal>
            <h3>{highlight.title}</h3>
            <p>{highlight.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section" id="member-success">
    <div class="container editorial-split">
      <div>
        <span class="eyebrow">MEMBERS & ALUMNI</span>
        <h2>Experience that keeps moving.</h2>
      </div>
      <div class="prose">
        <p class="lead">Member stories coming soon.</p>
        <p>
          This space will highlight experiences members choose to share:
          internships and careers, certifications and professional milestones,
          and leadership, research, or project work.
        </p>
        <p>
          Stories will be added with the member’s permission and leadership
          approval.
        </p>
        <a class="text-link" href={sitePath("/career/")}>
          Explore career connections
          <Arrow diagonal />
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container editorial-split">
      <h2 id="reports">Annual reports.</h2>
      <article class="report-card">
        <span class="eyebrow">2025–2026</span>
        <h3>
          Cyber Flyers
          <br />
          <em>Annual Report</em>
        </h3>
        <p class="availability">Report download coming soon.</p>
      </article>
    </div>
  </section>
</BaseLayout>
