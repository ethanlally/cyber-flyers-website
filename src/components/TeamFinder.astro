---
import { sitePath } from "../utils/paths";
import { teams } from "../data/content";
import Icon from "./Icon.astro";
const interests = [
  { label: "Creating & connecting", icon: "message", team: "cmac" },
  { label: "Hands-on security", icon: "command", team: "psat" },
  { label: "Research & discovery", icon: "search", team: "ctmr" },
  { label: "Helping others learn", icon: "asterisk", team: "teaching" },
  { label: "A little of everything", icon: "plus", team: "all" },
] as const;
---

<div class="team-finder" data-finder>
  <div
    class="finder-choices"
    hidden
    role="group"
    aria-label="Choose an interest"
  >
    {interests.map((interest, i) => (
      <button
        type="button"
        class:list={["interest-button", { selected: i === 0 }]}
        aria-pressed={i === 0 ? "true" : "false"}
        data-interest={interest.team}
      >
        <span aria-hidden="true">
          <Icon name={interest.icon} />
        </span>
        {interest.label}
        <span class="interest-selection" aria-hidden="true">
          <Icon name="check" />
        </span>
      </button>
    ))}
  </div>
  <div class="finder-results" aria-live="polite" aria-atomic="true">
    {teams.map((team) => (
      <article class:list={["finder-result", team.id]} data-result={team.id}>
        <span class="eyebrow">YOUR STARTING POINT / {team.acronym}</span>
        <h3>{team.name}</h3>
        <p>{team.summary}</p>
        <a class="text-link" href={sitePath(`/teams/#${team.id}`)}>
          Meet {team.acronym}
          <Icon name="arrow-right" />
        </a>
      </article>
    ))}
    <article class="finder-result" data-result="teaching" hidden>
      <span class="eyebrow">YOUR STARTING POINT / PSAT + CMAC</span>
      <h3>Make learning your impact.</h3>
      <p>
        Explore training and cybermindfulness with PSAT, or help cybersecurity
        ideas reach people through CMAC. Your interest in teaching connects both
        teams.
      </p>
      <a class="text-link" href={sitePath("/teams/")}>
        Explore both teams <Icon name="arrow-right" />
      </a>
    </article>
    <article class="finder-result" data-result="all" hidden>
      <span class="eyebrow">YOUR STARTING POINT / ALL THREE TEAMS</span>
      <h3>Curiosity is a great place to start.</h3>
      <p>
        Explore communication, training, and research. You don’t need to have it
        all figured out to find an area you’d like to grow in.
      </p>
      <a class="text-link" href={sitePath("/teams/")}>
        Explore all teams <Icon name="arrow-right" />
      </a>
    </article>
  </div>
</div>
<p class="finder-note">
  A starting point, not a box. Interests can connect across teams.
</p>
