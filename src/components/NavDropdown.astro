---
import { sitePath } from "../utils/paths";
interface Props {
  href: string;
  label: string;
  links: { href: string; label: string }[];
  callToAction?: boolean;
}
const { href, label, links, callToAction = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  path === (sitePath(href).replace(/\/$/, "") || "/");
const active = links.some((link) => isCurrent(link.href));
const submenuId = `nav-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}-submenu`;
---

<div class:list={["nav-group", { "nav-group-cta": callToAction }]}>
  <a
    href={sitePath(href)}
    class:list={[
      "nav-parent",
      { "is-active": active, "button button-red header-cta": callToAction },
    ]}
    aria-current={isCurrent(href) ? "page" : active ? "location" : undefined}
  >
    {label}
    <svg
      class="nav-indicator"
      width="10"
      height="6"
      viewBox="0 0 12 8"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="m1 1 5 5 5-5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </a>
  <details class="nav-dropdown">
    <summary aria-label={`${label} pages`}>
      <svg
        class="nav-chevron"
        width="12"
        height="8"
        viewBox="0 0 12 8"
        fill="none"
        aria-hidden="true"
      >
        <path d="m1 1 5 5 5-5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </summary>
    <ul class="nav-submenu" id={submenuId}>
      {links.map((link) => (
        <li>
          <a
            href={sitePath(link.href)}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</div>

<style>
  .nav-group {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-parent {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-indicator {
    display: none;
    flex-shrink: 0;
    transition: transform 140ms ease;
  }
  .nav-group:has(.nav-dropdown[open]) .nav-indicator {
    transform: rotate(180deg);
  }
  .nav-parent:not(.button) {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    line-height: 2;
  }
  .nav-parent:not(.button)::after {
    content: "";
    position: absolute;
    bottom: -7px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nav-parent:not(.button):hover::after,
  .nav-group:has(.nav-dropdown[open]) .nav-parent:not(.button)::after,
  .nav-parent:not(.button).is-active::after {
    transform: scaleX(1);
  }
  .nav-parent:not(.button).is-active {
    color: var(--red);
  }
  .nav-group .header-cta {
    margin: 0;
    gap: 8px;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    min-height: 44px;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
    border-radius: 3px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  details[open] summary {
    background: var(--pale);
  }
  details[open] .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-submenu {
    position: absolute;
    z-index: 1;
    top: calc(100% + 12px);
    left: 50%;
    translate: -50% 0;
    width: max-content;
    max-width: min(300px, calc(100vw - 48px));
    margin: 0;
    padding: 8px;
    list-style: none;
    background: white;
    border-radius: 4px;
    box-shadow: 0 8px 28px #141b4d1a;
  }
  .nav-submenu::before {
    content: "";
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .nav-submenu a {
    display: block;
    padding: 12px 16px;
    min-height: 44px;
    font-size: 14px;
    line-height: 1.5;
    border-radius: 2px;
    transition: background-color 120ms ease;
  }
  .nav-submenu a:hover,
  .nav-submenu a[aria-current] {
    background: var(--pale);
    color: var(--navy);
  }
  .nav-submenu a[aria-current] {
    font-weight: 600;
  }
  .nav-submenu a:focus-visible {
    outline-offset: -3px;
  }
  :global(.motion-paused) details[open] .nav-submenu {
    animation: none;
  }
  @media (min-width: 1081px) and (prefers-reduced-motion: no-preference) {
    details[open] .nav-submenu {
      animation: menu-enter 140ms ease-out;
    }
    @keyframes menu-enter {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (min-width: 1081px) and (hover: hover) and (pointer: fine) {
    :global(.js) .nav-group {
      min-height: 44px;
    }
    :global(.js) .nav-dropdown > summary {
      display: none;
    }
    :global(.js) .nav-indicator {
      display: block;
    }
  }
  @media (min-width: 1081px) and (max-width: 1200px) {
    .nav-group-cta .nav-submenu {
      max-width: calc(100% + 48px);
    }
  }
  @media (max-width: 1080px) {
    .nav-group {
      display: block;
      border-bottom: 1px solid #e6e8ed;
    }
    .nav-parent:not(.button) {
      display: block;
      padding: 14px 48px 14px 0;
    }
    .nav-parent:not(.button)::after {
      display: none;
    }
    .nav-dropdown > summary {
      position: absolute;
      top: 6px;
      right: 0;
      width: 44px;
    }
    .nav-submenu {
      position: static;
      translate: none;
      width: 100%;
      max-width: none;
      padding: 0 0 12px 16px;
      border: 0;
      box-shadow: none;
    }
    .nav-submenu a {
      border-left: 2px solid var(--rule);
    }
    .nav-submenu::before {
      display: none;
    }
    .nav-group-cta {
      margin-top: 20px;
      border-bottom: 0;
    }
    .nav-group-cta .nav-submenu {
      padding-top: 12px;
    }
    .nav-parent:not(.button).is-active {
      font-weight: 600;
    }
  }
</style>
