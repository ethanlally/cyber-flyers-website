---
import { commonFAQs, type FAQItem } from "../data/opportunities";
import { sitePath } from "../utils/paths";
interface Props {
  items?: FAQItem[];
}
const { items = commonFAQs } = Astro.props;
---

<div class="faq-list">
  {items.map((faq, i) => (
    <details>
      <summary>
        <span class="faq-number">{String(i + 1).padStart(2, "0")}</span>
        {faq.question}
        <span class="faq-toggle" aria-hidden="true">
          +
        </span>
      </summary>
      <div class="faq-answer">
        <p>{faq.answer}</p>
        {faq.href && (
          <a class="text-link" href={sitePath(faq.href)}>
            {faq.label}
          </a>
        )}
      </div>
    </details>
  ))}
</div>
